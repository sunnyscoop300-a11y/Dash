## Dash (.Dash) — syntaksfarver til nano ⚡
## Installér med:  make install-syntax

syntax dash "\.[Dd]ash$"
header "^#!.*dsh"
comment "#"

# kommandoer i starten af en linje
color brightwhite "^[[:space:]]*[a-zA-Z_./~-][a-zA-Z0-9_./~-]*"
# nøgleord
color brightred "\<(let|if|else|for|in|while|fn|return|break|continue|parallel|and|or|not)\>"
color red "\<(try|fail|echo|cd|exit)\>"
color yellow "\<(true|false|nil)\>"
color cyan "\<[0-9]+(\.[0-9]+)?\>"
# funktioner og metoder: print(  .trim(
color magenta "[a-zA-Z_][a-zA-Z0-9_]*\("
# & for enden af en linje: baggrundsjob
color brightmagenta "[[:space:]]&[[:space:]]*$"
# variabler i kommandoer: $navn  ${udtryk}  $(kommando)
color yellow "\$[a-zA-Z_][a-zA-Z0-9_]*" "\$\{[^}]*\}" "\$\([^)]*\)"
# pipes og redirects
color brightyellow " (\||>>|>|<|2>>|2>) "

# En linje med et ulige antal " er en streng der ikke er lukket:
# hele linjen lyser rødt, så en delt linje springer i øjnene.
color brightwhite,red "^([^"#]*"[^"]*")*[^"#]*"[^"]*$"
# strenge
color green ""([^"\\]|\\.)*""
color green "'[^']*'"
# {udtryk} og escape-koder inde i strenge
color brightblue "\{[^}"[:space:]]*\}"
color brightcyan "\\[nter0\\"{$]"

# kommentarer til sidst, så de vinder
color brightblack "(^|[[:space:]])#.*$"
color brightblack "^#!.*$"

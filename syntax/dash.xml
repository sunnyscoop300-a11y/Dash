<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language>
<!-- Dash (.Dash) — syntaksfarver til Kate / KWrite / KDevelop ⚡
     Installér med:  make install-syntax -->
<language name="Dash" section="Scripts" extensions="*.Dash;*.dash" mimetype="text/x-dash"
          version="1" kateversion="5.0" author="Bossun" license="MIT" indenter="cstyle">
  <highlighting>
    <list name="keywords">
      <item>let</item><item>if</item><item>else</item><item>for</item><item>in</item>
      <item>while</item><item>fn</item><item>return</item><item>break</item>
      <item>continue</item><item>parallel</item><item>and</item><item>or</item><item>not</item>
    </list>
    <list name="builtins">
      <item>echo</item><item>try</item><item>fail</item><item>cd</item><item>exit</item>
    </list>
    <list name="values">
      <item>true</item><item>false</item><item>nil</item>
    </list>
    <list name="functions">
      <item>print</item><item>len</item><item>str</item><item>int</item><item>float</item>
      <item>type</item><item>range</item><item>env</item><item>exists</item><item>is_dir</item>
      <item>is_file</item><item>which</item><item>read</item><item>write</item><item>append</item>
      <item>glob</item><item>input</item><item>now</item><item>sleep</item><item>round</item>
      <item>abs</item><item>min</item><item>max</item><item>cwd</item>
      <item>ask</item><item>menu</item><item>progress</item>
    </list>
    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <!-- en streng der ikke bliver lukket på linjen: vis den som fejl -->
        <RegExpr attribute="Error" String="&quot;(?:[^&quot;\\]|\\.)*$"/>
        <DetectChar char="&quot;" attribute="String" context="String"/>
        <DetectChar char="'" attribute="String" context="RawString"/>
        <RegExpr attribute="Comment" String="(?:^|(?&lt;=\s))#.*$"/>
        <keyword attribute="Keyword" String="keywords"/>
        <keyword attribute="Builtin" String="builtins"/>
        <keyword attribute="Value" String="values"/>
        <keyword attribute="Function" String="functions"/>
        <RegExpr attribute="Variable" String="\$\{[^}]*\}|\$\([^)]*\)|\$[A-Za-z_][A-Za-z0-9_]*"/>
        <Float attribute="Number"/>
        <Int attribute="Number"/>
        <RegExpr attribute="Function" String="[A-Za-z_][A-Za-z0-9_]*(?=\()"/>
        <AnyChar attribute="Operator" String="|&lt;&gt;&amp;"/>
      </context>
      <context name="String" attribute="String" lineEndContext="#pop">
        <RegExpr attribute="Escape" String="\\[nter0\\&quot;{$]"/>
        <DetectChar char="{" attribute="Interpolation" context="Interpolation"/>
        <RegExpr attribute="Variable" String="\$[A-Za-z_][A-Za-z0-9_]*"/>
        <DetectChar char="&quot;" attribute="String" context="#pop"/>
      </context>
      <context name="RawString" attribute="String" lineEndContext="#pop">
        <DetectChar char="'" attribute="String" context="#pop"/>
      </context>
      <context name="Interpolation" attribute="Interpolation" lineEndContext="#pop#pop">
        <DetectChar char="}" attribute="Interpolation" context="#pop"/>
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text"   defStyleNum="dsNormal"/>
      <itemData name="Keyword"       defStyleNum="dsKeyword"/>
      <itemData name="Builtin"       defStyleNum="dsBuiltIn"/>
      <itemData name="Value"         defStyleNum="dsConstant"/>
      <itemData name="Function"      defStyleNum="dsFunction"/>
      <itemData name="Variable"      defStyleNum="dsVariable"/>
      <itemData name="Number"        defStyleNum="dsDecVal"/>
      <itemData name="String"        defStyleNum="dsString"/>
      <itemData name="Escape"        defStyleNum="dsSpecialChar"/>
      <itemData name="Interpolation" defStyleNum="dsSpecialString"/>
      <itemData name="Operator"      defStyleNum="dsOperator"/>
      <itemData name="Comment"       defStyleNum="dsComment"/>
      <itemData name="Error"         defStyleNum="dsError"/>
    </itemDatas>
  </highlighting>
  <general>
    <comments><comment name="singleLine" start="#"/></comments>
    <keywords casesensitive="1"/>
  </general>
</language>

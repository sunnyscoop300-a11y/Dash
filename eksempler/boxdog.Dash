let HALLER = ["WAREHOUSE A", "WAREHOUSE B", "WAREHOUSE C", "WAREHOUSE D", "WAREHOUSE E", "WAREHOUSE F", "WAREHOUSE G", "WAREHOUSE H", "SANTA'S WORKSHOP 1", "SANTA'S WORKSHOP 2"]
let GEM = "{env("HOME", ".")}/.boxdog"

# ── rekorder: én linje pr. bane, navn=træk ──
let bedste = []
for i in range(BANER.len) { bedste.push(0) }
let lyd_til = true
let tema = ""
if exists(GEM) {
    for l in read(GEM).lines() {
        let d = l.split("=")
        if d.len >= 2 {
            if d[0] == "lyd" { lyd_til = d[1] == "1" }
            if d[0] == "tema" { tema = d[1] }
            for i in range(BANER.len) { if BANER[i].navn == d[0] { bedste[i] = int(d[1]) } }
        }
    }
}
fn gem() {
    let s = []
    for i in range(BANER.len) { if bedste[i] > 0 { s.push("{BANER[i].navn}={bedste[i]}") } }
    let l = "0"
    if lyd_til { l = "1" }
    s.push("lyd={l}")
    s.push("tema={tema}")
    write(GEM, s.join("\n") + "\n")
}

# ── lyde ──
let LYD_GÅ = sound("triangle", 620, 560, 0.03, 0.12)
let LYD_SKUB = sound("square", 150, 110, 0.08, 0.22)
let LYD_MÅL = sound("sine", 784, 1175, 0.12, 0.35)
let LYD_BUMP = sound("noise", 400, 200, 0.05, 0.15)
let LYD_VOV = sound("square", 330, 180, 0.14, 0.3)
let LYD_SEJR = sound("triangle", 523, 1047, 0.45, 0.4)
let LYD_FORTRYD = sound("sine", 600, 400, 0.06, 0.2)
fn spil_lyd(l) { if lyd_til { play(l) } }

# ── grafikken (klippet ud af BoxDog-mockuppen) ──
let mappe = script.dir
if mappe == "" { mappe = "." }
let KUNST = ""
for d in ["{mappe}/boxdog", "eksempler/boxdog", "{env("HOME", ".")}/.local/share/boxdog"] {
    if KUNST == "" and exists("{d}/side.png") { KUNST = d }
}
if KUNST == "" {
    print("BoxDog: kan ikke finde mappen boxdog/ med grafikken (ved siden af boxdog.Dash)")
    exit 1
}
let B_SIDE = image("{KUNST}/side.png")
let B_BAG = image("{KUNST}/bag.png")
let B_TØNDE = image("{KUNST}/toende.png")

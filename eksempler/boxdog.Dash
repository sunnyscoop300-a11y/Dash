let B_IKON = image("{KUNST}/kasse.png", 50, 55)
# animationerne (et felt er 100 px i billederne, de skaleres når de tegnes)
fn serie(navn, n) {
    let l = []
    for i in range(n) { l.push(image("{KUNST}/{navn}_{i}.png")) }
    return l
}
let A_H = serie("hund_h", 6)
let A_V = serie("hund_v", 6)
let A_N = serie("hund_n", 4)
let A_O = serie("hund_o", 4)
let A_MÅL = serie("maal", 16)
# julen: rød sidebjælke, sne, lyskæder og en julehund med nissehue
if tema == "" {
    tema = "normal"
    if $(sh -c "date +%m").trim() == "12" { tema = "jul" }
}
let J_SIDE = image("{KUNST}/jul/side.png")

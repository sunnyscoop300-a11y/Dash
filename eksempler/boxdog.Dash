#!/usr/bin/env dsh
# boxdog.Dash — BoxDog: en hundehvalp skubber kasser på plads på lageret (JJGui)
# bob-navn: BoxDog
# bob-kategori: spil
# bob-farve: #f0b040
# bob-om: Skub kasserne hen på pote-felterne på lageret. 55 baner i ti lagerhaller (to af dem med nisser), julelook i december, fortryd, rekorder, lyd og touch.
#
#   dsh eksempler/boxdog.Dash
#
# Piletaster eller WASD flytter hunden, Z fortryder, R starter forfra,
# L viser banerne, M slår lyden til og fra (også under SETTINGS). På telefonen: tryk på den side
# af hunden, den skal gå til. Rekorderne gemmes i ~/.boxdog.
#
# Grafikken ligger i boxdog/ ved siden af og er klippet ud af BoxDog-mockuppen
# med boxdog/klip.py (python3 klip.py mockup.png boxdog).


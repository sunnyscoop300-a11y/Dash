#!/usr/bin/env dsh
# bob.Dash — Bobs butik: en lille app-butik til dine egne Dash-programmer og spil (JJGui)
# bob-navn: Bob
# bob-kategori: program
# bob-farve: #3aa0a0
# bob-om: Bobs butik: installer, opdater og fjern dine Dash-programmer og spil. Bob bygger dem med Violet og lægger dem i menuen. Under System opdaterer han også selve Linux'en.
#
#   dsh eksempler/bob.Dash [mappe med .Dash-filer]
#
# Bob finder programmerne i ~/Dash/eksempler og ~/.local/share/bob/programmer
# (eller BOB_KILDER="mappe1:mappe2"). Et program kan beskrive sig selv øverst:
#
#   # bob-navn: Boxman
#   # bob-kategori: spil            (spil eller program)
#   # bob-farve: #e8a33a
#   # bob-om: Skub kasserne hen på målene.
#   # bob-ikon: ikoner/boxman.png   (standard: ikoner/<navn>.png ved siden af)
#   # bob: skjul                     (vis ikke i butikken)
#
# "Installer" bygger programmet med Violet til ~/.local/bin/<navn> og laver en
# genvej i ~/.local/share/applications, så det kan findes i menuen.

let HJEM = env("HOME", "/root")
let TMP = env("TMPDIR", "/tmp")
let BIN = "{HJEM}/.local/bin"
let APPS = "{HJEM}/.local/share/applications"
let DATA = "{HJEM}/.local/share/bob"
let IKONER = "{HJEM}/.local/share/icons/hicolor/256x256/apps"

let DSH = which("dsh")
if not DSH { DSH = which("dsh-hare") }
if not DSH { fail "Bob skal bruge dsh for at bygge programmerne" }

# ── find programmerne ────────────────────────────────────────────────
let kilder = []
if args.len > 0 { kilder.push(args[0]) }
let bk = env("BOB_KILDER", "")
if bk != "" { for k in bk.split(":") { kilder.push(k) } }
for k in ["{HJEM}/Dash/eksempler", "{HJEM}/dash/eksempler", "{DATA}/programmer"] { kilder.push(k) }

# kun tegn som JJGui's skrift kan tegne (ASCII og Latin-1 er højst 2 bytes)
fn pæn(t) {
    let r = ""
    for c in t.replace("—", "-").replace("–", "-").replace("→", "->").chars {
        if c.len <= 2 { r += c }
    }
    return r.replace("  ", " ").trim()
}

# "# tekst" → "tekst" (kun det første # fjernes)
fn uden_hash(t) {
    let dele = t.split("#")
    let r = ""
    for i in range(1, dele.len) {
        if i > 1 { r += "#" }
        r += dele[i]
    }
    return r.trim()
}

fn hash(fil) {
    let ud = $(try sha256sum $fil 2> /dev/null)
    if ud == "" { return "" }
    return ud.split(" ")[0]
}

let FARVER = ["#e8a33a", "#f07030", "#c060d0", "#62a548", "#4080e0", "#3aa0a0", "#d04a6a", "#8a6ad0"]
let progs = []
let set_id = {}
fn indlæs() {
    progs = []
    set_id = {}
    for k in kilder {
        if is_dir(k) {
            for f in glob("{k}/*.Dash") {
                let id = f.stem.lower()
                if not set_id.has(id) {
                    let p = {"fil": f, "id": id, "navn": f.stem, "kategori": "", "farve": "",
                             "om": "", "hjælp": [], "skjul": false, "gui": false,
                             "status": "ny", "job": "", "ikon": "", "lille": -1, "stor": -1}
                    let i = 0
                    let hoved = true
                    let sat = {}
                    for l in read(f).lines() {
                        i += 1
                        if l.contains("window(") { p.gui = true }
                        let t = l.trim()
                        # kun kommentarerne øverst i filen er programmets beskrivelse
                        if t != "" and not t.starts_with("#") { hoved = false }
                        if hoved and t.starts_with("#") and not t.starts_with("#!") {
                            let s = uden_hash(t)
                            let k = s.split(":")[0].trim()
                            let v = s.replace(k + ":", "").trim()
                            # hver nøgle tæller kun første gang (eksempler længere nede ignoreres)
                            if k.starts_with("bob-") and sat.has(k) { k = "" }
                            if k == "bob-navn" { p.navn = pæn(v) }
                            else if k == "bob-kategori" { p.kategori = v.lower() }
                            else if k == "bob-farve" { p.farve = "#" + v.replace("#", "") }
                            else if k == "bob-om" { p.om = pæn(v) }
                            else if k == "bob-ikon" { p.ikon = "{f.dir}/{v}" }
                            else if s == "bob: skjul" { p.skjul = true }
                            else if p.hjælp.len < 14 and not k.starts_with("bob-") and not s.starts_with("# bob") { p.hjælp.push(pæn(s)) }
                            if k.starts_with("bob-") { sat[k] = true }
                        }
                    }
                    if p.om == "" and p.hjælp.len > 0 { p.om = p.hjælp[0] }
                    if p.ikon == "" or not exists(p.ikon) { p.ikon = "{f.dir}/ikoner/{id}.png" }
                    if not exists(p.ikon) { p.ikon = "" }
                    if p.kategori == "" {
                        p.kategori = "program"
                        if (p.om + " " + p.navn).lower().contains("spil") { p.kategori = "spil" }
                    }
                    if p.farve == "#" or p.farve == "" { p.farve = FARVER[(id.len * 7 + i) % FARVER.len] }
                    if not p.skjul {
                        set_id[id] = true
                        progs.push(p)
                    }
                }
            }
        }
    }
    # sorter efter navn
    for i in range(1, progs.len) {
        let j = i
        while j > 0 and progs[j - 1].navn.lower() > progs[j].navn.lower() {
            let t = progs[j]
            progs[j] = progs[j - 1]
            progs[j - 1] = t
            j -= 1
        }
    }
    opdater_status()
}

fn opdater_status() {
    for p in progs {
        let bin = "{BIN}/{p.id}"
        let meta = "{DATA}/installeret/{p.id}"
        if p.job != "" { continue }
        if not exists(bin) {
            p.status = "ny"
        } else if exists(meta) and read(meta).trim() != hash(p.fil) {
            p.status = "opdatering"
        } else {
            p.status = "installeret"
        }
    }
}

# ── vindue ───────────────────────────────────────────────────────────
window("Bobs butik", 960, 640)
let W = width()
let H = height()

# ── tilstand ─────────────────────────────────────────────────────────
let fane = "alle"
let søg = ""
let rul = 0
let tid = 0.0
let detalje = ""
let bob_siger = "Hej! Velkommen i min butik. Hvad skal vi installere i dag?"
let bob_glad = 0.0
let job = ""
let bygger = 0         # Violets job fra &( ), mens et program bygges
let job_tjek = 0.0
let job_start = 0.0
let fejl_log = []
let nyt_klik = false

fn find(id) {
    for p in progs { if p.id == id { return p } }
    return nil
}
fn tæl(f) {
    let n = 0
    for p in progs { if passer(p, f) { n += 1 } }
    return n
}
fn passer(p, f) {
    if f == "alle" { return true }
    if f == "spil" { return p.kategori == "spil" }
    if f == "program" { return p.kategori != "spil" }
    if f == "installeret" { return p.status != "ny" }
    if f == "opdatering" { return p.status == "opdatering" }
    if f == "system" { return false }
    return true
}

# ── installering i baggrunden ────────────────────────────────────────
fn installer(p) {
    if job != "" {
        bob_siger = "Et øjeblik, jeg er stadig i gang med noget andet."
        return nil
    }
    job = p.id
    p.job = "bygger"
    job_start = tid
    fejl_log = []
    let log = "{TMP}/bob-{p.id}.log"
    mkdir -p $BIN
    let ud = "{BIN}/{p.id}"
    bygger = &($DSH build "{p.fil}" -o $ud > $log 2>&1)
    bob_siger = "Jeg bygger {p.navn} med Violet. Det tager et øjeblik..."
}

fn genvej(p) {
    let ikon = "applications-utilities"
    let kat = "Utility;"
    if p.kategori == "spil" {
        ikon = "applications-games"
        kat = "Game;"
    }
    # appens eget logo, hvis den har et
    if p.ikon != "" {
        mkdir -p $IKONER
        try cp "{p.ikon}" "{IKONER}/dash-{p.id}.png"
        ikon = "{IKONER}/dash-{p.id}.png"
    }
    # JJGui giver vinduet app id "dash-<navn>", så filen hedder det samme
    let d = "[Desktop Entry]\nType=Application\nName={p.navn}\nComment={p.om}\nExec={BIN}/{p.id}\nIcon={ikon}\nStartupWMClass=dash-{p.id}\nTerminal=false\nCategories={kat}\n"
    mkdir -p $APPS
    rm -f "{APPS}/bob-{p.id}.desktop"
    write("{APPS}/dash-{p.id}.desktop", d)
    try update-desktop-database $APPS 2> /dev/null
}

fn job_færdig() {
    let p = find(job)
    let kode = wait(bygger)
    job = ""
    if p == nil { return nil }
    p.job = ""
    if kode == 0 {
        mkdir -p "{DATA}/installeret"
        write("{DATA}/installeret/{p.id}", hash(p.fil))
        if p.gui { genvej(p) }
        p.status = "installeret"
        bob_siger = "Færdig! {p.navn} ligger nu i menuen og i ~/.local/bin."
        bob_glad = 3.0
    } else {
        fejl_log = read("{TMP}/bob-{p.id}.log").lines()
        bob_siger = "Øv, {p.navn} kunne ikke bygges. Se fejlen under detaljerne."
        detalje = p.id
    }
}

fn fjern(p) {
    rm -f "{BIN}/{p.id}" "{APPS}/bob-{p.id}.desktop" "{APPS}/dash-{p.id}.desktop" "{IKONER}/dash-{p.id}.png" "{DATA}/installeret/{p.id}"
    p.status = "ny"
    bob_siger = "{p.navn} er fjernet. Den ligger stadig på hylden, hvis du fortryder."
}

fn åbn(p) {
    let prog = "{BIN}/{p.id}"
    $prog < /dev/null &
    bob_siger = "God fornøjelse med {p.navn}!"
    bob_glad = 2.0
}

# ═════════════════════════════ TEGNING ═══════════════════════════════

fn ombryd(s, maxw, st) {
    let linjer = []
    let l = ""
    for o in s.split(" ") {
        let prøv = o
        if l != "" { prøv = l + " " + o }
        if text_width(prøv, st) > maxw and l != "" {
            linjer.push(l)
            l = o
        } else {
            l = prøv
        }
    }
    if l != "" { linjer.push(l) }
    return linjer
}

fn klip(s, maxw, st) {
    if text_width(s, st) <= maxw { return s }
    let r = ""
    for c in s.chars {
        if text_width(r + c + "..", st) > maxw { return r + ".." }
        r += c
    }
    return r
}

fn inde(x, y, w, h) {
    let m = mouse()
    return m[0] >= x and m[0] < x + w and m[1] >= y and m[1] < y + h
}

fn knap(x, y, w, h, s, bg, aktiv) {
    let over = inde(x, y, w, h) and aktiv
    let c = bg
    if not aktiv { c = "#b8ad98" }
    round_rect(x, y + 3, w, h, 10, "#00000040")
    round_rect(x, y, w, h, 10, c)
    if over { round_rect(x, y, w, h, 10, "#ffffff30") }
    text(x + (w - text_width(s, 1)) / 2, y + (h - 16) / 2, s, "#ffffff", 1)
    return over and clicked() and not nyt_klik
}

# markisen over butikken
fn markise() {
    let n = int(W / 48) + 1
    for i in range(n) {
        let c = "#d0453a"
        if i % 2 == 1 { c = "#fff4dc" }
        rect(i * 48, 0, 48, 46, c)
        circle(i * 48 + 24, 46, 24, c)
    }
    rect(0, 0, W, 6, "#8a2a22")
}

# Bob selv: en rund butiksmand med kasket og forklæde
fn bob_figur(x, y) {
    let m = mouse()
    let hop = 0
    if bob_glad > 0 { hop = int(abs(sin(tid * 10)) * 8) }
    if job != "" { hop = int(abs(sin(tid * 6)) * 3) }
    let by = y - hop
    round_rect(x - 32, y + 36, 64, 12, 6, "#00000040")
    circle(x, by, 42, "#2a8080")
    circle(x, by, 39, "#3aa0a0")
    circle(x - 12, by - 14, 10, "#ffffff30")
    # forklæde
    round_rect(x - 24, by + 2, 48, 36, 8, "#fff4dc")
    rect(x - 24, by + 2, 48, 6, "#d0453a")
    round_rect(x - 10, by + 18, 20, 12, 4, "#f0dcb4")
    # øjne der følger musen
    for s in [-1, 1] {
        let ex = x + s * 14
        let ey = by - 16
        circle(ex, ey, 10, "#ffffff")
        let dx = m[0] - ex
        let dy = m[1] - ey
        let l = sqrt(dx * dx + dy * dy) + 1
        let blink = int(tid * 10) % 37 == 0
        if blink {
            rect(ex - 9, ey - 1, 18, 3, "#1a2a2a")
        } else {
            circle(ex + int(dx / l * 4), ey + int(dy / l * 4), 5, "#1a2a2a")
            circle(ex + int(dx / l * 4) - 2, ey + int(dy / l * 4) - 2, 2, "#ffffff")
        }
    }
    # smil
    if bob_glad > 0 {
        polygon([[x - 12, by - 2], [x + 12, by - 2], [x, by + 8]], "#7a2a22")
    } else {
        line(x - 8, by - 1, x - 3, by + 2, "#1a2a2a")
        line(x - 3, by + 2, x + 3, by + 2, "#1a2a2a")
        line(x + 3, by + 2, x + 8, by - 1, "#1a2a2a")
    }
    # kasket
    polygon([[x - 30, by - 30], [x - 22, by - 46], [x + 22, by - 46], [x + 30, by - 30]], "#d0453a")
    round_rect(x - 4, by - 34, 44, 7, 3, "#a83228")
    circle(x, by - 47, 4, "#fff4dc")
}

fn taleboble(x, y, w, s) {
    let linjer = ombryd(s, w - 24, 1)
    let h = linjer.len * 18 + 18
    round_rect(x + 3, y + 4, w, h, 12, "#00000040")
    round_rect(x, y, w, h, 12, "#ffffff")
    polygon([[x + 40, y + h], [x + 70, y + h], [x + 52, y + h + 16]], "#ffffff")
    for i in range(linjer.len) { text(x + 12, y + 9 + i * 18, linjer[i], "#2a2a3a", 1) }
}

fn sidebjælke() {
    rect(0, 46, 220, H - 46, "#8a5a2b")
    for i in range(0, H, 40) { line(0, 60 + i, 220, 60 + i, "#7a4c22") }
    taleboble(14, 70, 192, bob_siger)
    bob_figur(70, 300)
    text(126, 262, "BOB", "#fff4dc", 3)
    text(130, 312, "butik", "#f0d8a8", 1)
    let faner = [["alle", "Alle"], ["spil", "Spil"], ["program", "Programmer"],
                 ["installeret", "Installeret"], ["opdatering", "Opdateringer"], ["system", "System"]]
    for i in range(faner.len) {
        let f = faner[i]
        let y = 362 + i * 45
        let over = inde(14, y, 192, 40)
        let bg = "#6b4424"
        if f[0] == fane { bg = "#3aa0a0" } else if over { bg = "#9a6a35" }
        round_rect(14, y, 192, 40, 10, bg)
        text(28, y + 12, f[1], "#fff4dc", 1)
        let n = tæl(f[0])
        let ns = "{n}"
        let nc = "#00000040"
        if f[0] == "opdatering" and n > 0 { nc = "#d0453a" }
        if f[0] == "system" {
            n = sys_antal()
            ns = "{n}"
            if not sys_tjekket { ns = "?" }
            if n > 0 { nc = "#d0453a" }
        }
        round_rect(184 - text_width(ns, 1), y + 10, text_width(ns, 1) + 12, 20, 10, nc)
        text(190 - text_width(ns, 1), y + 12, ns, "#ffffff", 1)
        if over and clicked() and detalje == "" {
            fane = f[0]
            rul = 0
        }
    }
}

fn ikon(p, x, y, s) {
    if p.ikon != "" {
        # appens eget logo, skaleret én gang til kortet og detaljerne
        let id = p.lille
        if s > 64 { id = p.stor }
        if id < 0 {
            id = image(p.ikon, s, s)
            if s > 64 { p.stor = id } else { p.lille = id }
        }
        round_rect(x + 2, y + 4, s, s, int(s / 5), "#00000030")
        draw(id, x, y)
        return nil
    }
    round_rect(x + 2, y + 4, s, s, int(s / 5), "#00000040")
    round_rect(x, y, s, s, int(s / 5), p.farve)
    round_rect(x, y, s, int(s / 2), int(s / 5), "#ffffff25")
    let bogstav = p.navn.chars.first.upper()
    let st = max(1, int(s / 22))
    text(x + (s - text_width(bogstav, st)) / 2, y + (s - 16 * st) / 2, bogstav, "#ffffff", st)
    # lille mærke: spil = to knapper, program = et vindue
    let mx = x + s - int(s / 3)
    let my = y + s - int(s / 3)
    let ms = int(s / 4)
    if p.kategori == "spil" {
        round_rect(mx, my + int(ms / 4), ms, int(ms * 0.6), 3, "#00000050")
        circle(mx + int(ms * 0.7), my + int(ms / 2), 2, "#ffffff")
    } else {
        rect(mx, my, ms, int(ms * 0.75), "#00000050")
        rect(mx, my, ms, 3, "#ffffff90")
    }
}

fn status_knapper(p, x, y, w) {
    if p.job != "" {
        round_rect(x, y, w, 30, 10, "#e0d4b8")
        let bw = int(w / 3)
        let bx = x + int((sin(tid * 3) * 0.5 + 0.5) * (w - bw))
        round_rect(bx, y, bw, 30, 10, "#3aa0a0")
        let t = "Bygger..."
        text(x + (w - text_width(t, 1)) / 2, y + 7, t, "#2a2a3a", 1)
        return nil
    }
    let fri = job == ""
    if p.status == "ny" {
        if knap(x, y, w, 30, "Installer", "#3f8a3a", fri) { installer(p) }
    } else if p.status == "opdatering" {
        if knap(x, y, w, 30, "Opdater", "#d08a20", fri) { installer(p) }
    } else {
        let hw = int((w - 8) / 2)
        if p.gui {
            if knap(x, y, hw, 30, "Åbn", "#3aa0a0", true) { åbn(p) }
        } else {
            round_rect(x, y, hw, 30, 10, "#e0d4b8")
            text(x + (hw - text_width("i terminal", 1)) / 2, y + 7, "i terminal", "#7a6a50", 1)
        }
        if knap(x + hw + 8, y, hw, 30, "Fjern", "#a04a3a", fri) { fjern(p) }
    }
}

let KX = 236
let KY = 116
let KW = 228
let KH = 160
let GAB = 12
# ── System: opdater selve Linux'en ───────────────────────────────────
# Bob tjekker i baggrunden hvad der venter (uden sudo), og "Opdater alt"
# åbner skrivebordets terminal med et lille Dash-script, så du selv
# skriver din sudo-kode dér.
let SYS_TMP = "{TMP}/bob-system"
let sys_kilder = []      # [{navn, farve, tjek, opdater, job, fil, antal, linjer, besked}]
let sys_tjekket = false
let sys_rul = 0
let sys_færdig_fil = "{SYS_TMP}/færdig"
let sys_kører = false
let distro = ""
if exists("/etc/os-release") {
    for l in read("/etc/os-release").lines() {
        if l.starts_with("PRETTY_NAME=") { distro = l.replace("PRETTY_NAME=", "").replace("\"", "") }
    }
}

fn sys_kilde(navn, farve, tjek, opdater) {
    sys_kilder.push({"navn": navn, "farve": farve, "tjek": tjek, "opdater": opdater,
                     "job": 0, "fil": "{SYS_TMP}/{navn}.txt", "antal": -1, "linjer": [], "besked": "tjekker..."})
}

fn sys_find() {
    sys_kilder = []
    let aur = ""
    if which("paru") != nil { aur = "paru" }
    if which("yay") != nil { aur = "yay" }
    if which("pacman") != nil {
        let op = ["sudo", "pacman", "-Syu"]
        if aur != "" { op = [aur, "-Syu"] }
        if which("checkupdates") != nil {
            sys_kilde("pacman", "#1793d1", ["checkupdates"], op)
        } else {
            sys_kilde("pacman", "#1793d1", [], op)
        }
        if aur != "" { sys_kilde("AUR ({aur})", "#3aa0a0", [aur, "-Qua"], []) }
    } else if which("apt") != nil and env("TERMUX_VERSION", "") == "" {
        sys_kilde("apt", "#d70a53", ["apt", "list", "--upgradable"], ["sudo", "apt", "update", ";", "sudo", "apt", "full-upgrade"])
    } else if which("dnf") != nil {
        sys_kilde("dnf", "#51a2da", ["dnf", "check-update", "-q"], ["sudo", "dnf", "upgrade", "--refresh"])
    } else if which("zypper") != nil {
        sys_kilde("zypper", "#73ba25", ["zypper", "-q", "list-updates"], ["sudo", "zypper", "update"])
    } else if which("xbps-install") != nil {
        sys_kilde("xbps", "#478061", ["xbps-install", "-Mun"], ["sudo", "xbps-install", "-Su"])
    }
    if which("flatpak") != nil {
        sys_kilde("flatpak", "#4a86cf", ["flatpak", "remote-ls", "--updates", "--columns=application,version"], ["flatpak", "update"])
    }
    if which("snap") != nil {
        sys_kilde("snap", "#e95420", ["snap", "refresh", "--list"], ["sudo", "snap", "refresh"])
    }
}

fn sys_tjek() {
    mkdir -p $SYS_TMP
    for k in sys_kilder {
        k.antal = -1
        k.linjer = []
        if k.tjek.len == 0 {
            k.besked = "installer pacman-contrib for at se dem"
            k.antal = -2
            continue
        }
        k.besked = "tjekker..."
        let cmd = k.tjek
        k.job = &($cmd > "{k.fil}" 2> /dev/null < /dev/null)
    }
    sys_tjekket = true
}

# er tjekkene færdige? → tæl linjerne
fn sys_poll() {
    for k in sys_kilder {
        if k.antal != -1 or k.tjek.len == 0 { continue }
        if running(k.job) { continue }
        wait(k.job)
        let ls = []
        if exists(k.fil) {
            for l in read(k.fil).lines() {
                let t = l.trim()
                if t == "" or t.starts_with("Listing") or t.starts_with("Name ") or t.starts_with("All snaps") { continue }
                if k.navn == "zypper" and not t.contains("|") { continue }
                if k.navn == "zypper" and (t.starts_with("S ") or t.starts_with("--")) { continue }
                ls.push(t)
            }
        }
        k.linjer = ls
        k.antal = ls.len
        if ls.len == 0 { k.besked = "alt er opdateret" } else { k.besked = "{ls.len} opdateringer" }
    }
    # er opdateringen i terminalen færdig? så tjek igen
    if sys_kører and exists(sys_færdig_fil) {
        sys_kører = false
        rm -f $sys_færdig_fil
        bob_siger = "Systemet er opdateret! Jeg tjekker lige en gang til."
        bob_glad = 3.0
        sys_tjek()
    }
}

fn sys_antal() {
    let n = 0
    for k in sys_kilder { if k.antal > 0 { n += k.antal } }
    return n
}

# ── terminalen (samme valg som Huskebogen) ──
fn sys_terminal() {
    let valgt = env("BOB_TERMINAL", env("TERMINAL", ""))
    if valgt != "" and which(valgt) != nil { return valgt }
    let skrivebord = env("XDG_CURRENT_DESKTOP", "").lower()
    if skrivebord.contains("xfce") and which("xfce4-terminal") != nil { return "xfce4-terminal" }
    if skrivebord.contains("kde") and which("konsole") != nil { return "konsole" }
    if skrivebord.contains("gnome") and which("ptyxis") != nil { return "ptyxis" }
    if skrivebord.contains("gnome") and which("gnome-terminal") != nil { return "gnome-terminal" }
    for t in ["kitty", "alacritty", "foot", "wezterm", "konsole", "gnome-terminal", "ptyxis", "kgx",
              "xfce4-terminal", "tilix", "terminator", "xterm", "urxvt", "st"] {
        if which(t) != nil { return t }
    }
    return ""
}
fn sys_kald(t, prog) {
    let navn = t.split("/").last
    let start = [t, "-e"]
    if navn == "kitty" or navn == "foot" { start = [t] }
    if navn == "wezterm" { start = [t, "start", "--"] }
    if navn == "gnome-terminal" or navn == "kgx" or navn == "ptyxis" { start = [t, "--"] }
    if navn == "xfce4-terminal" { start = [t, "-x"] }
    if navn == "tilix" or navn == "terminator" { return [t, "-e", prog.join(" ")] }
    for d in prog { start.push(d) }
    return start
}

fn sys_opdater() {
    let term = sys_terminal()
    if term == "" {
        bob_siger = "Jeg fandt ingen terminal. Sæt BOB_TERMINAL=din-terminal."
        return nil
    }
    mkdir -p $SYS_TMP
    rm -f $sys_færdig_fil
    # et lille Dash-script, som terminalen kører
    let s = ["# Bobs systemopdatering (lavet af Bob)",
             "echo \"\\e[1;36m🔧 Bob opdaterer {distro}\\e[0m\"",
             "let fejl = 0"]
    for k in sys_kilder {
        if k.opdater.len == 0 { continue }
        let dele = [[]]
        for d in k.opdater {
            if d == ";" { dele.push([]) } else { dele[dele.len - 1].push(d) }
        }
        for d in dele {
            s.push("echo \"\"")
            s.push("echo \"\\e[1;33m▶ {d.join(" ")}\\e[0m\"")
            s.push("try {d.join(" ")}")
            s.push("if status != 0 \{ fejl += 1 \}")
        }
    }
    s.push("write(\"{sys_færdig_fil}\", str(fejl))")
    s.push("echo \"\"")
    s.push("if fejl == 0 \{ echo \"\\e[1;32m✔ Færdig! Systemet er opdateret.\\e[0m\" \} else \{ echo \"\\e[1;31m✘ \{fejl\} trin fejlede — se ovenfor.\\e[0m\" \}")
    s.push("input(\"Tryk Enter for at lukke vinduet \")")
    let fil = "{SYS_TMP}/opdater.Dash"
    write(fil, s.join("\n") + "\n")
    let kald = sys_kald(term, [DSH, fil])
    $kald < /dev/null > /dev/null 2>&1 &
    sys_kører = true
    bob_siger = "Jeg har åbnet {term.split("/").last}. Skriv din kode dér, så opdaterer jeg."
    bob_glad = 3.0
}

fn system_side() {
    let x = KX
    let y = 62
    let w = W - KX - 16
    text(x, y + 4, "Systemopdatering", "#2a2a3a", 2)
    if distro != "" { text(x, y + 36, pæn(distro), "#9a8a70", 1) }
    if not sys_tjekket {
        sys_find()
        sys_tjek()
    }
    let alle_klar = true
    for k in sys_kilder { if k.antal == -1 { alle_klar = false } }
    # knapperne
    let n = sys_antal()
    let lt = "Opdater alt"
    if sys_kører { lt = "Opdaterer..." }
    if knap(W - 16 - 170, y, 170, 36, lt, "#3f8a3a", not sys_kører and sys_kilder.len > 0 and detalje == "") { sys_opdater() }
    if knap(W - 16 - 170 - 130, y, 120, 36, "Tjek igen", "#3aa0a0", alle_klar and detalje == "") { sys_tjek() }
    if sys_kilder.len == 0 {
        text(x, y + 80, "Bob kender ikke din pakkehåndtering.", "#7a6a50", 2)
        return nil
    }
    # en boks pr. kilde
    let by = y + 64
    let bw = int((w - (sys_kilder.len - 1) * 10) / sys_kilder.len)
    for i in range(sys_kilder.len) {
        let k = sys_kilder[i]
        let bx = x + i * (bw + 10)
        round_rect(bx + 2, by + 4, bw, 64, 12, "#00000020")
        round_rect(bx, by, bw, 64, 12, "#ffffff")
        round_rect(bx, by, 8, 64, 4, k.farve)
        text(bx + 18, by + 10, k.navn, "#2a2a3a", 1)
        let c = "#9a8a70"
        let tal = "..."
        if k.antal == 0 {
            c = "#3f8a3a"
            tal = "OK"
        } else if k.antal > 0 {
            c = "#d0453a"
            tal = str(k.antal)
        } else if k.antal == -2 {
            tal = "?"
        }
        text(bx + bw - 16 - text_width(tal, 2), by + 8, tal, c, 2)
        text(bx + 18, by + 38, klip(pæn(k.besked), bw - 30, 1), "#7a6a50", 1)
    }
    # pakkelisten
    let ly = by + 84
    let lh = H - ly - 16
    round_rect(x, ly, w, lh, 12, "#fffaf0")
    let linjer = []
    for k in sys_kilder {
        for l in k.linjer {
            let d = l.split(" ")
            let navn = d[0]
            let fra = ""
            let til = ""
            if k.navn == "pacman" or k.navn.starts_with("AUR") {
                if d.len >= 4 {
                    fra = d[1]
                    til = d[3]
                }
            } else if k.navn == "flatpak" {
                let t = l.split("\t")
                navn = t[0]
                if t.len > 1 { til = t[1] }
            } else if k.navn == "apt" {
                navn = d[0].split("/")[0]
                if d.len > 1 { til = d[1] }
            } else if d.len > 1 {
                til = d[d.len - 1]
            }
            linjer.push([k.navn, navn, fra, til])
        }
    }
    let pr_side = int((lh - 44) / 20)
    if inde(x, ly, w, lh) and wheel() != 0 and detalje == "" {
        sys_rul = max(0, min(max(0, linjer.len - pr_side), sys_rul - wheel()))
    }
    if linjer.len == 0 {
        let t = "Tjekker..."
        if alle_klar { t = "Ingen opdateringer - alt er friskt!" }
        text(x + 20, ly + 20, t, "#7a6a50", 2)
    } else {
        # skriften er ikke lige bred, så hver kolonne får sin egen plads
        let kx = [x + 16, x + 120, x + 400, x + 560]
        text(kx[0], ly + 14, "KILDE", "#9a8a70", 1)
        text(kx[1], ly + 14, "PAKKE", "#9a8a70", 1)
        text(kx[2], ly + 14, "NU", "#9a8a70", 1)
        text(kx[3], ly + 14, "NY", "#9a8a70", 1)
        for i in range(pr_side) {
            let j = i + sys_rul
            if j >= linjer.len { break }
            let r = linjer[j]
            let ry = ly + 38 + i * 20
            if i % 2 == 0 { rect(x + 8, ry - 3, w - 16, 20, "#f3e6cc") }
            text(kx[0], ry, klip(pæn(r[0]), 96, 1), "#9a8a70", 1)
            text(kx[1], ry, klip(pæn(r[1]), 270, 1), "#2a2a3a", 1)
            text(kx[2], ry, klip(pæn("{r[2]:.22}"), 150, 1), "#5a5040", 1)
            text(kx[3], ry, klip(pæn(r[3]), w - (kx[3] - x) - 20, 1), "#2a7a3a", 1)
        }
        if linjer.len > pr_side {
            let t = "rul for flere ({sys_rul + 1}-{min(linjer.len, sys_rul + pr_side)} af {linjer.len})"
            text(x + w - 16 - text_width(t, 1), ly + lh - 22, t, "#9a8a70", 1)
        }
    }
    if sys_kører {
        let t = "Opdateringen kører i terminalen..."
        text(x + 16, ly + lh - 22, t, "#3aa0a0", 1)
    }
}

fn butik() {
    rect(220, 46, W - 220, H - 46, "#f6ead0")
    for i in range(0, W, 60) { line(220 + i, 46, 220 + i, H, "#efe0c0") }
    if fane == "system" {
        system_side()
        return nil
    }
    # søgefelt (kopiér og indsæt virker, også med højreklik)
    let st = textbox("søg", KX, 62, W - KX - 16, {"h": 38, "r": 12, "tom": "Søg i butikken ( / )",
        "bund": "#ffffff", "kant": "#e0d4b8", "fokus": "#3aa0a0", "tekst": "#2a2a3a",
        "dæmp": "#a8a090", "markering": "#3aa0a060", "aktiv": detalje == ""})
    if st != søg {
        søg = st
        rul = 0
    }
    # kortene
    let s = st.lower()
    let vis = []
    for p in progs {
        if passer(p, fane) and (s == "" or (p.navn + " " + p.om + " " + p.id).lower().contains(s)) { vis.push(p) }
    }
    if vis.len == 0 {
        let t = "Hylden er tom her."
        if progs.len == 0 { t = "Bob fandt ingen .Dash-programmer." }
        text(KX + 20, KY + 30, t, "#7a6a50", 2)
        if progs.len == 0 {
            let y = KY + 70
            for k in kilder {
                text(KX + 20, y, "kigger i: " + klip(k, 600, 1), "#9a8a70", 1)
                y += 20
            }
        }
        return nil
    }
    let rækker = int((vis.len + 2) / 3)
    let synlige = 3
    if inde(KX, KY, W - KX, H - KY) and wheel() != 0 and detalje == "" {
        rul = max(0, min(max(0, rækker - synlige), rul - wheel()))
    }
    for i in range(vis.len) {
        let r = int(i / 3) - rul
        let c = i % 3
        if r >= 0 and r < synlige {
            let p = vis[i]
            let x = KX + c * (KW + GAB)
            let y = KY + r * (KH + GAB)
            let over = inde(x, y, KW, KH) and detalje == ""
            round_rect(x + 3, y + 5, KW, KH, 14, "#00000025")
            round_rect(x, y, KW, KH, 14, "#ffffff")
            if over { outline(x, y, KW, KH, p.farve) }
            ikon(p, x + 14, y + 14, 56)
            text(x + 82, y + 18, klip(p.navn, KW - 92, 1), "#2a2a3a", 1)
            let kat = "Program"
            if p.kategori == "spil" { kat = "Spil" }
            if p.status == "installeret" { kat += " · installeret" }
            if p.status == "opdatering" { kat += " · ny version" }
            text(x + 82, y + 40, kat, "#9a8a70", 1)
            let ls = ombryd(p.om, KW - 28, 1)
            for j in range(min(2, ls.len)) {
                let lt = ls[j]
                if j == 1 and ls.len > 2 { lt = klip(lt + " ...", KW - 28, 1) }
                text(x + 14, y + 80 + j * 18, lt, "#5a5040", 1)
            }
            let ky = y + KH - 42
            status_knapper(p, x + 14, ky, KW - 28)
            if over and clicked() and not inde(x + 14, ky, KW - 28, 30) and not nyt_klik { detalje = p.id }
        }
    }
    if rækker > synlige {
        let t = "rul for flere ({rul + 1}/{rækker - synlige + 1})"
        text(W - 20 - text_width(t, 1), H - 22, t, "#9a8a70", 1)
    }
}

fn detaljer() {
    if detalje == "" { return nil }
    let p = find(detalje)
    if p == nil {
        detalje = ""
        return nil
    }
    rect(0, 0, W, H, "#00000090")
    let px = 180
    let py = 56
    let pw = 600
    let ph = 540
    round_rect(px + 4, py + 6, pw, ph, 18, "#00000060")
    round_rect(px, py, pw, ph, 18, "#fffaf0")
    round_rect(px, py, pw, 110, 18, p.farve)
    rect(px, py + 90, pw, 20, "#fffaf0")
    ikon(p, px + 24, py + 24, 96)
    text(px + 140, py + 30, klip(p.navn, pw - 200, 1), "#ffffff", 3)
    let kat = "Program"
    if p.kategori == "spil" { kat = "Spil" }
    text(px + 142, py + 82, "{kat} · {p.fil.name}", "#5a5040", 1)
    # luk
    if knap(px + pw - 50, py + 16, 34, 30, "X", "#00000050", true) or pressed("esc") { detalje = "" }
    let y = py + 136
    for l in ombryd(p.om, pw - 48, 1) {
        text(px + 24, y, l, "#2a2a3a", 1)
        y += 20
    }
    y += 10
    if fejl_log.len > 0 and job == "" and p.status != "installeret" {
        round_rect(px + 20, y, pw - 40, 200, 10, "#2a1a1a")
        text(px + 32, y + 8, "Violet sagde:", "#ff9a8a", 1)
        let start_l = max(0, fejl_log.len - 9)
        for j in range(start_l, fejl_log.len) {
            text(px + 32, y + 30 + (j - start_l) * 18, klip(fejl_log[j], pw - 70, 1), "#f0d8d0", 1)
        }
        y += 210
    } else {
        for l in p.hjælp {
            for d in ombryd(l, pw - 48, 1) {
                if y < py + ph - 80 {
                    text(px + 24, y, d, "#6a6050", 1)
                    y += 18
                }
            }
        }
    }
    let st = "Ikke installeret"
    if p.status == "installeret" { st = "Installeret i ~/.local/bin/{p.id}" }
    if p.status == "opdatering" { st = "Der er en ny version af kildekoden" }
    text(px + 24, py + ph - 52, st, "#9a8a70", 1)
    status_knapper(p, px + pw - 244, py + ph - 58, 220)
}

# ═════════════════════════════ TASTER ════════════════════════════════

fn taster() {
    if focused("søg") {
        if pressed("esc") {
            søg = ""
            textbox_set("søg", "", false)
        }
        return nil
    }
    if detalje != "" { return nil }
    if typed() == "/" { textbox_set("søg", søg, true) }
    if pressed("down") { rul += 1 }
    if pressed("up") { rul = max(0, rul - 1) }
}

# ── testkroge til skærmbilleder ──────────────────────────────────────
indlæs()
let skud = env("JJ_SKUD", "")
let scene = env("JJ_SCENE", "")
let skud_tid = 0.0
if scene == "detalje" and progs.len > 0 { detalje = progs[0].id }
if scene == "system" { fane = "system" }
if scene == "bygger" and progs.len > 0 {
    progs[1].job = "bygger"
    job = progs[1].id
    bob_siger = "Jeg bygger {progs[1].navn} med Violet. Det tager et øjeblik..."
}

# ═════════════════════════════ LØKKEN ════════════════════════════════

while frame() {
    let dt = delta()
    tid += dt
    if bob_glad > 0 { bob_glad -= dt }
    # er Violet færdig?
    if job != "" and scene == "" {
        job_tjek -= dt
        if job_tjek <= 0 {
            job_tjek = 0.3
            if not running(bygger) { job_færdig() }
        }
    }
    if sys_tjekket { sys_poll() }
    nyt_klik = false
    let åben_før = detalje != ""
    clear("#f6ead0")
    butik()
    # et klik, der åbner detaljerne, må ikke også trykke på en knap derinde
    if not åben_før and detalje != "" { nyt_klik = true }
    sidebjælke()
    markise()
    let titel = "Bobs butik"
    round_rect(W / 2 - 110, 8, 220, 34, 10, "#6b4424")
    text(W / 2 - text_width(titel, 2) / 2, 10, titel, "#fff4dc", 2)
    detaljer()
    taster()

    if skud != "" {
        skud_tid += dt
        if skud_tid > 0.5 {
            screenshot(skud)
            break
        }
    }
}

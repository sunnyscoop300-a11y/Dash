#!/usr/bin/env dsh
# bob.Dash — Bobs butik: en lille app-butik til dine egne Dash-programmer og spil (JJGui)
# bob-navn: Bob
# bob-kategori: program
# bob-farve: #3aa0a0
# bob-om: Bobs butik: installer, opdater og fjern dine Dash-programmer og spil. Bob bygger dem med Violet og lægger dem i menuen.
#
#   dsh eksempler/bob.Dash [mappe med .Dash-filer]
#
# Bob finder programmerne i ~/Dash/eksempler og ~/.local/share/bob/programmer
# (eller BOB_KILDER="mappe1:mappe2"). Et program kan beskrive sig selv øverst:
#
#   # bob-navn: Boxman
#   # bob-kategori: spil            (spil eller program)
#   # bob-farve: #e8a33a
#   # bob-om: Skub kasserne hen på målene.
#   # bob: skjul                     (vis ikke i butikken)
#
# "Installer" bygger programmet med Violet til ~/.local/bin/<navn> og laver en
# genvej i ~/.local/share/applications, så det kan findes i menuen.

let HJEM = env("HOME", "/root")
let TMP = env("TMPDIR", "/tmp")
let BIN = "{HJEM}/.local/bin"
let APPS = "{HJEM}/.local/share/applications"
let DATA = "{HJEM}/.local/share/bob"

let DSH = which("dsh")
if not DSH { DSH = which("dsh-hare") }
if not DSH { fail "Bob skal bruge dsh for at bygge programmerne" }

fn q(s) { return "'" + s.replace("'", "'\\''") + "'" }

# ── find programmerne ────────────────────────────────────────────────
let kilder = []
if args.len > 0 { kilder.push(args[0]) }
let bk = env("BOB_KILDER", "")
if bk != "" { for k in bk.split(":") { kilder.push(k) } }
for k in ["{HJEM}/Dash/eksempler", "{HJEM}/dash/eksempler", "{DATA}/programmer"] { kilder.push(k) }

# kun tegn som JJGui's skrift kan tegne (ASCII og Latin-1 er højst 2 bytes)
fn pæn(t) {
    let r = ""
    for c in t.replace("—", "-").replace("–", "-").replace("→", "->").chars {
        if c.len <= 2 { r += c }
    }
    return r.replace("  ", " ").trim()
}

# "# tekst" → "tekst" (kun det første # fjernes)
fn uden_hash(t) {
    let dele = t.split("#")
    let r = ""
    for i in range(1, dele.len) {
        if i > 1 { r += "#" }
        r += dele[i]
    }
    return r.trim()
}

fn hash(fil) {
    return $(sh -c "sha256sum {q(fil)} 2>/dev/null | cut -c1-64").trim()
}

let FARVER = ["#e8a33a", "#f07030", "#c060d0", "#62a548", "#4080e0", "#3aa0a0", "#d04a6a", "#8a6ad0"]
let progs = []
let set_id = {}
fn indlæs() {
    progs = []
    set_id = {}
    for k in kilder {
        if is_dir(k) {
            for f in glob("{k}/*.Dash") {
                let id = f.stem.lower()
                if not set_id.has(id) {
                    let p = {"fil": f, "id": id, "navn": f.stem, "kategori": "", "farve": "",
                             "om": "", "hjælp": [], "skjul": false, "gui": false,
                             "status": "ny", "job": ""}
                    let i = 0
                    let hoved = true
                    let sat = {}
                    for l in read(f).lines() {
                        i += 1
                        if l.contains("window(") { p.gui = true }
                        let t = l.trim()
                        # kun kommentarerne øverst i filen er programmets beskrivelse
                        if t != "" and not t.starts_with("#") { hoved = false }
                        if hoved and t.starts_with("#") and not t.starts_with("#!") {
                            let s = uden_hash(t)
                            let k = s.split(":")[0].trim()
                            let v = s.replace(k + ":", "").trim()
                            # hver nøgle tæller kun første gang (eksempler længere nede ignoreres)
                            if k.starts_with("bob-") and sat.has(k) { k = "" }
                            if k == "bob-navn" { p.navn = pæn(v) }
                            else if k == "bob-kategori" { p.kategori = v.lower() }
                            else if k == "bob-farve" { p.farve = "#" + v.replace("#", "") }
                            else if k == "bob-om" { p.om = pæn(v) }
                            else if s == "bob: skjul" { p.skjul = true }
                            else if p.hjælp.len < 14 and not k.starts_with("bob-") and not s.starts_with("# bob") { p.hjælp.push(pæn(s)) }
                            if k.starts_with("bob-") { sat[k] = true }
                        }
                    }
                    if p.om == "" and p.hjælp.len > 0 { p.om = p.hjælp[0] }
                    if p.kategori == "" {
                        p.kategori = "program"
                        if (p.om + " " + p.navn).lower().contains("spil") { p.kategori = "spil" }
                    }
                    if p.farve == "#" or p.farve == "" { p.farve = FARVER[(id.len * 7 + i) % FARVER.len] }
                    if not p.skjul {
                        set_id[id] = true
                        progs.push(p)
                    }
                }
            }
        }
    }
    # sorter efter navn
    for i in range(1, progs.len) {
        let j = i
        while j > 0 and progs[j - 1].navn.lower() > progs[j].navn.lower() {
            let t = progs[j]
            progs[j] = progs[j - 1]
            progs[j - 1] = t
            j -= 1
        }
    }
    opdater_status()
}

fn opdater_status() {
    for p in progs {
        let bin = "{BIN}/{p.id}"
        let meta = "{DATA}/installeret/{p.id}"
        if p.job != "" { continue }
        if not exists(bin) {
            p.status = "ny"
        } else if exists(meta) and read(meta).trim() != hash(p.fil) {
            p.status = "opdatering"
        } else {
            p.status = "installeret"
        }
    }
}

# ── vindue ───────────────────────────────────────────────────────────
window("Bobs butik", 960, 640)
let W = width()
let H = height()

# ── tilstand ─────────────────────────────────────────────────────────
let fane = "alle"
let søg = []
let søg_aktiv = false
let rul = 0
let tid = 0.0
let detalje = ""
let bob_siger = "Hej! Velkommen i min butik. Hvad skal vi installere i dag?"
let bob_glad = 0.0
let job = ""
let job_tjek = 0.0
let job_start = 0.0
let fejl_log = []
let nyt_klik = false

fn find(id) {
    for p in progs { if p.id == id { return p } }
    return nil
}
fn tæl(f) {
    let n = 0
    for p in progs { if passer(p, f) { n += 1 } }
    return n
}
fn passer(p, f) {
    if f == "alle" { return true }
    if f == "spil" { return p.kategori == "spil" }
    if f == "program" { return p.kategori != "spil" }
    if f == "installeret" { return p.status != "ny" }
    if f == "opdatering" { return p.status == "opdatering" }
    return true
}

# ── installering i baggrunden ────────────────────────────────────────
fn installer(p) {
    if job != "" {
        bob_siger = "Et øjeblik, jeg er stadig i gang med noget andet."
        return nil
    }
    job = p.id
    p.job = "bygger"
    job_start = tid
    fejl_log = []
    let log = "{TMP}/bob-{p.id}.log"
    let færdig = "{TMP}/bob-{p.id}.færdig"
    try sh -c "rm -f {q(færdig)}; mkdir -p {q(BIN)}"
    let cmd = "{q(DSH)} build {q(p.fil)} -o {q(BIN + "/" + p.id)} > {q(log)} 2>&1; echo \$? > {q(færdig)}"
    try sh -c "( {cmd} ) </dev/null >/dev/null 2>&1 &"
    bob_siger = "Jeg bygger {p.navn} med Violet. Det tager et øjeblik..."
}

fn genvej(p) {
    let ikon = "applications-utilities"
    let kat = "Utility;"
    if p.kategori == "spil" {
        ikon = "applications-games"
        kat = "Game;"
    }
    let d = "[Desktop Entry]\nType=Application\nName={p.navn}\nComment={p.om}\nExec={BIN}/{p.id}\nIcon={ikon}\nTerminal=false\nCategories={kat}\n"
    try sh -c "mkdir -p {q(APPS)}"
    write("{APPS}/bob-{p.id}.desktop", d)
}

fn job_færdig() {
    let p = find(job)
    let færdig = "{TMP}/bob-{job}.færdig"
    let kode = read(færdig).trim()
    try sh -c "rm -f {q(færdig)}"
    job = ""
    if p == nil { return nil }
    p.job = ""
    if kode == "0" {
        try sh -c "mkdir -p {q(DATA + "/installeret")}"
        write("{DATA}/installeret/{p.id}", hash(p.fil))
        if p.gui { genvej(p) }
        p.status = "installeret"
        bob_siger = "Færdig! {p.navn} ligger nu i menuen og i ~/.local/bin."
        bob_glad = 3.0
    } else {
        fejl_log = read("{TMP}/bob-{p.id}.log").lines()
        bob_siger = "Øv, {p.navn} kunne ikke bygges. Se fejlen under detaljerne."
        detalje = p.id
    }
}

fn fjern(p) {
    try sh -c "rm -f {q(BIN + "/" + p.id)} {q(APPS + "/bob-" + p.id + ".desktop")} {q(DATA + "/installeret/" + p.id)}"
    p.status = "ny"
    bob_siger = "{p.navn} er fjernet. Den ligger stadig på hylden, hvis du fortryder."
}

fn åbn(p) {
    try sh -c "{q(BIN + "/" + p.id)} </dev/null >/dev/null 2>&1 &"
    bob_siger = "God fornøjelse med {p.navn}!"
    bob_glad = 2.0
}

# ═════════════════════════════ TEGNING ═══════════════════════════════

fn ombryd(s, maxw, st) {
    let linjer = []
    let l = ""
    for o in s.split(" ") {
        let prøv = o
        if l != "" { prøv = l + " " + o }
        if text_width(prøv, st) > maxw and l != "" {
            linjer.push(l)
            l = o
        } else {
            l = prøv
        }
    }
    if l != "" { linjer.push(l) }
    return linjer
}

fn klip(s, maxw, st) {
    if text_width(s, st) <= maxw { return s }
    let r = ""
    for c in s.chars {
        if text_width(r + c + "..", st) > maxw { return r + ".." }
        r += c
    }
    return r
}

fn inde(x, y, w, h) {
    let m = mouse()
    return m[0] >= x and m[0] < x + w and m[1] >= y and m[1] < y + h
}

fn knap(x, y, w, h, s, bg, aktiv) {
    let over = inde(x, y, w, h) and aktiv
    let c = bg
    if not aktiv { c = "#b8ad98" }
    round_rect(x, y + 3, w, h, 10, "#00000040")
    round_rect(x, y, w, h, 10, c)
    if over { round_rect(x, y, w, h, 10, "#ffffff30") }
    text(x + (w - text_width(s, 1)) / 2, y + (h - 16) / 2, s, "#ffffff", 1)
    return over and clicked() and not nyt_klik
}

# markisen over butikken
fn markise() {
    let n = int(W / 48) + 1
    for i in range(n) {
        let c = "#d0453a"
        if i % 2 == 1 { c = "#fff4dc" }
        rect(i * 48, 0, 48, 46, c)
        circle(i * 48 + 24, 46, 24, c)
    }
    rect(0, 0, W, 6, "#8a2a22")
}

# Bob selv: en rund butiksmand med kasket og forklæde
fn bob_figur(x, y) {
    let m = mouse()
    let hop = 0
    if bob_glad > 0 { hop = int(abs(sin(tid * 10)) * 8) }
    if job != "" { hop = int(abs(sin(tid * 6)) * 3) }
    let by = y - hop
    round_rect(x - 32, y + 36, 64, 12, 6, "#00000040")
    circle(x, by, 42, "#2a8080")
    circle(x, by, 39, "#3aa0a0")
    circle(x - 12, by - 14, 10, "#ffffff30")
    # forklæde
    round_rect(x - 24, by + 2, 48, 36, 8, "#fff4dc")
    rect(x - 24, by + 2, 48, 6, "#d0453a")
    round_rect(x - 10, by + 18, 20, 12, 4, "#f0dcb4")
    # øjne der følger musen
    for s in [-1, 1] {
        let ex = x + s * 14
        let ey = by - 16
        circle(ex, ey, 10, "#ffffff")
        let dx = m[0] - ex
        let dy = m[1] - ey
        let l = sqrt(dx * dx + dy * dy) + 1
        let blink = int(tid * 10) % 37 == 0
        if blink {
            rect(ex - 9, ey - 1, 18, 3, "#1a2a2a")
        } else {
            circle(ex + int(dx / l * 4), ey + int(dy / l * 4), 5, "#1a2a2a")
            circle(ex + int(dx / l * 4) - 2, ey + int(dy / l * 4) - 2, 2, "#ffffff")
        }
    }
    # smil
    if bob_glad > 0 {
        polygon([[x - 12, by - 2], [x + 12, by - 2], [x, by + 8]], "#7a2a22")
    } else {
        line(x - 8, by - 1, x - 3, by + 2, "#1a2a2a")
        line(x - 3, by + 2, x + 3, by + 2, "#1a2a2a")
        line(x + 3, by + 2, x + 8, by - 1, "#1a2a2a")
    }
    # kasket
    polygon([[x - 30, by - 30], [x - 22, by - 46], [x + 22, by - 46], [x + 30, by - 30]], "#d0453a")
    round_rect(x - 4, by - 34, 44, 7, 3, "#a83228")
    circle(x, by - 47, 4, "#fff4dc")
}

fn taleboble(x, y, w, s) {
    let linjer = ombryd(s, w - 24, 1)
    let h = linjer.len * 18 + 18
    round_rect(x + 3, y + 4, w, h, 12, "#00000040")
    round_rect(x, y, w, h, 12, "#ffffff")
    polygon([[x + 40, y + h], [x + 70, y + h], [x + 52, y + h + 16]], "#ffffff")
    for i in range(linjer.len) { text(x + 12, y + 9 + i * 18, linjer[i], "#2a2a3a", 1) }
}

fn sidebjælke() {
    rect(0, 46, 220, H - 46, "#8a5a2b")
    for i in range(0, H, 40) { line(0, 60 + i, 220, 60 + i, "#7a4c22") }
    taleboble(14, 70, 192, bob_siger)
    bob_figur(70, 300)
    text(126, 262, "BOB", "#fff4dc", 3)
    text(130, 312, "butik", "#f0d8a8", 1)
    let faner = [["alle", "Alle"], ["spil", "Spil"], ["program", "Programmer"],
                 ["installeret", "Installeret"], ["opdatering", "Opdateringer"]]
    for i in range(faner.len) {
        let f = faner[i]
        let y = 370 + i * 48
        let over = inde(14, y, 192, 40)
        let bg = "#6b4424"
        if f[0] == fane { bg = "#3aa0a0" } else if over { bg = "#9a6a35" }
        round_rect(14, y, 192, 40, 10, bg)
        text(28, y + 12, f[1], "#fff4dc", 1)
        let n = tæl(f[0])
        let ns = "{n}"
        let nc = "#00000040"
        if f[0] == "opdatering" and n > 0 { nc = "#d0453a" }
        round_rect(184 - text_width(ns, 1), y + 10, text_width(ns, 1) + 12, 20, 10, nc)
        text(190 - text_width(ns, 1), y + 12, ns, "#ffffff", 1)
        if over and clicked() and detalje == "" {
            fane = f[0]
            rul = 0
        }
    }
}

fn ikon(p, x, y, s) {
    round_rect(x + 2, y + 4, s, s, int(s / 5), "#00000040")
    round_rect(x, y, s, s, int(s / 5), p.farve)
    round_rect(x, y, s, int(s / 2), int(s / 5), "#ffffff25")
    let bogstav = p.navn.chars.first.upper()
    let st = max(1, int(s / 22))
    text(x + (s - text_width(bogstav, st)) / 2, y + (s - 16 * st) / 2, bogstav, "#ffffff", st)
    # lille mærke: spil = to knapper, program = et vindue
    let mx = x + s - int(s / 3)
    let my = y + s - int(s / 3)
    let ms = int(s / 4)
    if p.kategori == "spil" {
        round_rect(mx, my + int(ms / 4), ms, int(ms * 0.6), 3, "#00000050")
        circle(mx + int(ms * 0.7), my + int(ms / 2), 2, "#ffffff")
    } else {
        rect(mx, my, ms, int(ms * 0.75), "#00000050")
        rect(mx, my, ms, 3, "#ffffff90")
    }
}

fn status_knapper(p, x, y, w) {
    if p.job != "" {
        round_rect(x, y, w, 30, 10, "#e0d4b8")
        let bw = int(w / 3)
        let bx = x + int((sin(tid * 3) * 0.5 + 0.5) * (w - bw))
        round_rect(bx, y, bw, 30, 10, "#3aa0a0")
        let t = "Bygger..."
        text(x + (w - text_width(t, 1)) / 2, y + 7, t, "#2a2a3a", 1)
        return nil
    }
    let fri = job == ""
    if p.status == "ny" {
        if knap(x, y, w, 30, "Installer", "#3f8a3a", fri) { installer(p) }
    } else if p.status == "opdatering" {
        if knap(x, y, w, 30, "Opdater", "#d08a20", fri) { installer(p) }
    } else {
        let hw = int((w - 8) / 2)
        if p.gui {
            if knap(x, y, hw, 30, "Åbn", "#3aa0a0", true) { åbn(p) }
        } else {
            round_rect(x, y, hw, 30, 10, "#e0d4b8")
            text(x + (hw - text_width("i terminal", 1)) / 2, y + 7, "i terminal", "#7a6a50", 1)
        }
        if knap(x + hw + 8, y, hw, 30, "Fjern", "#a04a3a", fri) { fjern(p) }
    }
}

let KX = 236
let KY = 116
let KW = 228
let KH = 160
let GAB = 12
fn butik() {
    rect(220, 46, W - 220, H - 46, "#f6ead0")
    for i in range(0, W, 60) { line(220 + i, 46, 220 + i, H, "#efe0c0") }
    # søgefelt
    let sbg = "#ffffff"
    round_rect(KX, 62, W - KX - 16, 38, 12, "#e0d4b8")
    round_rect(KX + 2, 64, W - KX - 20, 34, 10, sbg)
    let st = søg.join("")
    if st == "" and not søg_aktiv {
        text(KX + 16, 73, "Søg i butikken ( / )", "#a8a090", 1)
    } else {
        let blink = ""
        if søg_aktiv and int(tid * 2) % 2 == 0 { blink = "|" }
        text(KX + 16, 73, st + blink, "#2a2a3a", 1)
    }
    if clicked() and detalje == "" { søg_aktiv = inde(KX, 62, W - KX - 16, 38) }
    # kortene
    let s = st.lower()
    let vis = []
    for p in progs {
        if passer(p, fane) and (s == "" or (p.navn + " " + p.om + " " + p.id).lower().contains(s)) { vis.push(p) }
    }
    if vis.len == 0 {
        let t = "Hylden er tom her."
        if progs.len == 0 { t = "Bob fandt ingen .Dash-programmer." }
        text(KX + 20, KY + 30, t, "#7a6a50", 2)
        if progs.len == 0 {
            let y = KY + 70
            for k in kilder {
                text(KX + 20, y, "kigger i: " + klip(k, 600, 1), "#9a8a70", 1)
                y += 20
            }
        }
        return nil
    }
    let rækker = int((vis.len + 2) / 3)
    let synlige = 3
    if inde(KX, KY, W - KX, H - KY) and wheel() != 0 and detalje == "" {
        rul = max(0, min(max(0, rækker - synlige), rul - wheel()))
    }
    for i in range(vis.len) {
        let r = int(i / 3) - rul
        let c = i % 3
        if r >= 0 and r < synlige {
            let p = vis[i]
            let x = KX + c * (KW + GAB)
            let y = KY + r * (KH + GAB)
            let over = inde(x, y, KW, KH) and detalje == ""
            round_rect(x + 3, y + 5, KW, KH, 14, "#00000025")
            round_rect(x, y, KW, KH, 14, "#ffffff")
            if over { outline(x, y, KW, KH, p.farve) }
            ikon(p, x + 14, y + 14, 56)
            text(x + 82, y + 18, klip(p.navn, KW - 92, 1), "#2a2a3a", 1)
            let kat = "Program"
            if p.kategori == "spil" { kat = "Spil" }
            if p.status == "installeret" { kat += " · installeret" }
            if p.status == "opdatering" { kat += " · ny version" }
            text(x + 82, y + 40, kat, "#9a8a70", 1)
            let ls = ombryd(p.om, KW - 28, 1)
            for j in range(min(2, ls.len)) {
                let lt = ls[j]
                if j == 1 and ls.len > 2 { lt = klip(lt + " ...", KW - 28, 1) }
                text(x + 14, y + 80 + j * 18, lt, "#5a5040", 1)
            }
            let ky = y + KH - 42
            status_knapper(p, x + 14, ky, KW - 28)
            if over and clicked() and not inde(x + 14, ky, KW - 28, 30) and not nyt_klik { detalje = p.id }
        }
    }
    if rækker > synlige {
        let t = "rul for flere ({rul + 1}/{rækker - synlige + 1})"
        text(W - 20 - text_width(t, 1), H - 22, t, "#9a8a70", 1)
    }
}

fn detaljer() {
    if detalje == "" { return nil }
    let p = find(detalje)
    if p == nil {
        detalje = ""
        return nil
    }
    rect(0, 0, W, H, "#00000090")
    let px = 180
    let py = 56
    let pw = 600
    let ph = 540
    round_rect(px + 4, py + 6, pw, ph, 18, "#00000060")
    round_rect(px, py, pw, ph, 18, "#fffaf0")
    round_rect(px, py, pw, 110, 18, p.farve)
    rect(px, py + 90, pw, 20, "#fffaf0")
    ikon(p, px + 24, py + 24, 96)
    text(px + 140, py + 30, klip(p.navn, pw - 200, 1), "#ffffff", 3)
    let kat = "Program"
    if p.kategori == "spil" { kat = "Spil" }
    text(px + 142, py + 82, "{kat} · {p.fil.name}", "#5a5040", 1)
    # luk
    if knap(px + pw - 50, py + 16, 34, 30, "X", "#00000050", true) or pressed("esc") { detalje = "" }
    let y = py + 136
    for l in ombryd(p.om, pw - 48, 1) {
        text(px + 24, y, l, "#2a2a3a", 1)
        y += 20
    }
    y += 10
    if fejl_log.len > 0 and job == "" and p.status != "installeret" {
        round_rect(px + 20, y, pw - 40, 200, 10, "#2a1a1a")
        text(px + 32, y + 8, "Violet sagde:", "#ff9a8a", 1)
        let start_l = max(0, fejl_log.len - 9)
        for j in range(start_l, fejl_log.len) {
            text(px + 32, y + 30 + (j - start_l) * 18, klip(fejl_log[j], pw - 70, 1), "#f0d8d0", 1)
        }
        y += 210
    } else {
        for l in p.hjælp {
            for d in ombryd(l, pw - 48, 1) {
                if y < py + ph - 80 {
                    text(px + 24, y, d, "#6a6050", 1)
                    y += 18
                }
            }
        }
    }
    let st = "Ikke installeret"
    if p.status == "installeret" { st = "Installeret i ~/.local/bin/{p.id}" }
    if p.status == "opdatering" { st = "Der er en ny version af kildekoden" }
    text(px + 24, py + ph - 52, st, "#9a8a70", 1)
    status_knapper(p, px + pw - 244, py + ph - 58, 220)
}

# ═════════════════════════════ TASTER ════════════════════════════════

fn taster() {
    if søg_aktiv {
        let t = typed()
        for c in t.chars { søg.push(c) }
        if t != "" { rul = 0 }
        if pressed("backspace") and søg.len > 0 { søg.pop() }
        if pressed("esc") {
            søg = []
            søg_aktiv = false
        }
        return nil
    }
    if detalje != "" { return nil }
    if typed() == "/" { søg_aktiv = true }
    if pressed("down") { rul += 1 }
    if pressed("up") { rul = max(0, rul - 1) }
}

# ── testkroge til skærmbilleder ──────────────────────────────────────
indlæs()
let skud = env("JJ_SKUD", "")
let scene = env("JJ_SCENE", "")
let skud_tid = 0.0
if scene == "detalje" and progs.len > 0 { detalje = progs[0].id }
if scene == "bygger" and progs.len > 0 {
    progs[1].job = "bygger"
    job = progs[1].id
    bob_siger = "Jeg bygger {progs[1].navn} med Violet. Det tager et øjeblik..."
}

# ═════════════════════════════ LØKKEN ════════════════════════════════

while frame() {
    let dt = delta()
    tid += dt
    if bob_glad > 0 { bob_glad -= dt }
    # er Violet færdig?
    if job != "" and scene == "" {
        job_tjek -= dt
        if job_tjek <= 0 {
            job_tjek = 0.3
            if exists("{TMP}/bob-{job}.færdig") { job_færdig() }
        }
    }
    nyt_klik = false
    let åben_før = detalje != ""
    clear("#f6ead0")
    butik()
    # et klik, der åbner detaljerne, må ikke også trykke på en knap derinde
    if not åben_før and detalje != "" { nyt_klik = true }
    sidebjælke()
    markise()
    let titel = "Bobs butik"
    round_rect(W / 2 - 110, 8, 220, 34, 10, "#6b4424")
    text(W / 2 - text_width(titel, 2) / 2, 10, titel, "#fff4dc", 2)
    detaljer()
    taster()

    if skud != "" {
        skud_tid += dt
        if skud_tid > 0.5 {
            screenshot(skud)
            break
        }
    }
}

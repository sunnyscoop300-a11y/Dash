# fishout/fisk.Dash — fiskene, guldfisken og støvlen i FISH OUT 🐟
# Del af FISH OUT (eksempler/fishout.Dash).

let LILLE = [
    "....ddd.....",
    "d..bbbbbbb..",
    "dd.bbdbdbbbb",
    "ddbbbdbdbbob",
    "dd.lllllllll",
    "d...lllllll.",
]
let STOR = [
    ".......dddd.......",
    "d....bbbbbbbbbb...",
    "dd..bbbdbbdbbbbbb.",
    "ddbbbbbdbbdbbbbobb",
    "ddbbbbbdbbdbbbbbbb",
    "dd..lllllllllllll.",
    "d....llllllllllll.",
    ".......dd...dd....",
]
# ålen: lang og tynd, lever helt nede ved bunden
let ÅL = [
    "...ddddddddddddddddddd....",
    "dbbbbbbbbbbbbbbbbbbbbbbbb.",
    "dbbbbbbbbbbbbbbbbbbbbbbbob",
    ".lllllllllllllllllllllllll",
    "...d..............d.......",
]
# sværdfisken: stor, hurtig og med et langt sværd (s)
let SVÆRD = [
    "......dd.....................",
    ".....dddd....................",
    "d...bbbbbbbbbb...............",
    "dd.bbbbbbbbbbbbbb............",
    "ddbbbbbdbbdbbbbobbsssssssssss",
    "dd.lllllllllllllll...........",
    "d...lllllllllllll............",
    ".....d....d..................",
]
# DarkFish: KATCHA's gotiske fisk — sort med lilla finner, glødende øje og hugtænder (w)
let DARK = [
    "......d.ddd.d.....",
    "d....bbbbbbbbbb...",
    "dd..bbbdbbdbbbbbb.",
    "ddbbbbbdbbdbbbbobb",
    "ddbbbbbdbbdbbbbbbw",
    "dd..lllllllllllww.",
    "d....llllllllllll.",
    ".......dd...dd....",
]
let STØVLE = [
    "..dddddd..",
    "..bbbbbb..",
    "..bdbdbb..",
    "..bbbbbb..",
    "..bdbdbb..",
    "..bbbbbb..",
    "..bbbbbbbb",
    "dbbbbbbbbbb",
    "dddddddddddd",
]

# farver: krop (b), mørk (d), bug (l), øje (o)
let FARVER = {
    "rød": {"b": "#f0603a", "d": "#b8331f", "l": "#ffb08a", "o": "#101010"},
    "blå": {"b": "#4aa8f0", "d": "#2463b8", "l": "#bfe4ff", "o": "#101010"},
    "grøn": {"b": "#8cc48a", "d": "#4a8a52", "l": "#d4ecc4", "o": "#101010"},
    "lilla": {"b": "#a07ae6", "d": "#6a44b0", "l": "#d8c4ff", "o": "#101010"},
    "ål": {"b": "#6b6a3a", "d": "#3d3c1c", "l": "#a8a46a", "o": "#101010"},
    "sværd": {"b": "#3d6f9e", "d": "#22405e", "l": "#c8dceb", "o": "#101010", "s": "#dfe6ee"},
    "dark": {"b": "#1a1024", "d": "#8a4cff", "l": "#3a2458", "o": "#ff3cdc", "w": "#f4f0ff"},
    "guld": {"b": "#ffd23a", "d": "#d08a10", "l": "#fff2a0", "o": "#101010"},
    "støvle": {"b": "#8a5a32", "d": "#5a3518", "l": "#8a5a32", "o": "#101010"},
}

# hvilken fisk der svømmer i hvilken dybde (match med intervaller og en vagt)
fn fisk_type(dybde) {
    match dybde {
        _ if random(18) == 0 => { return "guld" }
        _ if random(22) == 0 => { return "dark" }
        _ if random(14) == 0 => { return "sværd" }
        _ if dybde > 200 and random(4) == 0 => { return "ål" }
        0..80 => { return "rød" }
        81..150 => { return "blå" }
        151..220 => { return "grøn" }
        _ => { return "lilla" }
    }
}

fn point(type) {
    match type {
        "rød" => { return 10 }
        "blå" => { return 20 }
        "grøn" => { return 30 }
        "lilla" => { return 50 }
        "ål" => { return 40 }
        "sværd" => { return 75 }
        "dark" => { return 66 }
        "guld" => { return 100 }
        "støvle" => { return -50 }
        _ => { return 0 }
    }
}

fn fart(type) {
    match type {
        "sværd" => { return 240 }
        "dark" => { return 150 }
        "guld" => { return 190 }
        "ål" => { return 55 }
        "rød", "blå" => { return 110 }
        _ => { return 70 }
    }
}

fn form(type) {
    match type {
        "grøn", "lilla" => { return STOR }
        "støvle" => { return STØVLE }
        "ål" => { return ÅL }
        "sværd" => { return SVÆRD }
        "dark" => { return DARK }
        _ => { return LILLE }
    }
}

fn ny_fisk() {
    let y = VAND + 50 + random(BUND - VAND - 110)
    let type = fisk_type(y - VAND - 50)
    let højre = random(2) == 0
    let f = {"type": type, "y": y, "v": fart(type) + random(40), "højre": højre, "x": 0, "b": form(type)[0].len * S, "h": form(type).len * S}
    if højre { f["x"] = -f["b"] - random(200) } else { f["x"] = W + random(200) }
    return f
}

fn tegn_fisk(f, t) {
    let bob = int(sin(t * 4 + f["y"]) * 3)
    # ålen vrider sig
    if f["type"] == "ål" { bob = int(sin(t * 9 + f["x"] * 0.03) * 7) }
    sprite(form(f["type"]), f["x"], f["y"] + bob, S, FARVER[f["type"]], not f["højre"])
    if f["type"] == "dark" {
        # lilla gnister omkring den
        let k = 0
        while k < 4 {
            let gx = f["x"] + ((int(t * 6) + k * 17) % 9) * 8
            let gy = f["y"] - 8 + ((int(t * 4) + k * 5) % 4) * 12
            rect(gx, gy, 4, 4, "#c48cff")
            k += 1
        }
    }
    if f["type"] == "guld" {
        # glimmer
        let k = 0
        while k < 3 {
            let gx = f["x"] + 6 + ((int(t * 7) + k * 13) % 5) * 9
            let gy = f["y"] - 10 + ((int(t * 5) + k * 7) % 3) * 12
            rect(gx, gy, 4, 12, "#fff6a0")
            rect(gx - 4, gy + 4, 12, 4, "#fff6a0")
            k += 1
        }
    }
}

fn tegn_støvle(x, y) {
    sprite(STØVLE, x, y, S + 1, FARVER["støvle"], false)
}
